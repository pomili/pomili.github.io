---
import InteriorPage from '../../components/InteriorPage.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, pathTo } from '../../lib/site';
const posts = await getPosts();
---
<InteriorPage title="所有文章" kicker="POSTS / INDEX" description="记录想法，整理发现。这里收藏每一次表达。">
  <div class="listing-toolbar">
    <span>共 {posts.length} 篇文章</span>
    <a class="text-link" href={pathTo('rss.xml')}>RSS 订阅 <span aria-hidden="true">↗</span></a>
  </div>
  {posts.length > 0 ? <PostList posts={posts} /> : <div class="empty-state"><p>还没有发布文章，先留一点空白。</p></div>}
</InteriorPage>
