---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, pathTo } from '../../lib/site';
const posts = await getPosts();
---
<BaseLayout title="文章" description="pomili 的文章与笔记。记录想法、整理发现，让思考慢慢生长。">
  <div class="shell page-content">
    <header class="page-intro"><span class="eyebrow">THE NOTEBOOK</span><h1>一些文字，<br /><span class="muted-heading">一些正在生长的想法。</span></h1><p>随手记下，再慢慢整理。这里收藏每一次表达。</p><div class="archive-caption"><span>{String(posts.length).padStart(2, '0')} 篇文章</span><a class="text-link" href={pathTo('rss.xml')}>通过 RSS 订阅 ↗</a></div></header>
    <PostList posts={posts} />
  </div>
</BaseLayout>
