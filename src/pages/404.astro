---
import InteriorPage from '../components/InteriorPage.astro';
import { pathTo } from '../lib/site';
---
<InteriorPage title="页面未找到" kicker="ERROR / 404" description="这个页面不存在，或已经换了一个位置。" noindex>
  <section class="empty-state not-found" aria-labelledby="not-found-title">
    <span class="error-number" aria-hidden="true">404</span>
    <h2 id="not-found-title">好像走进了一页空白</h2>
    <p>不如回到首页，或在文章列表里重新翻一翻。</p>
    <div class="empty-state-actions">
      <a class="button button-primary" href={pathTo()}>回到首页 <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={pathTo('posts/')}>浏览文章</a>
    </div>
  </section>
</InteriorPage>
