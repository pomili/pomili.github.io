---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { pathTo } from '../lib/site';
---
<BaseLayout title="页面走丢了" noindex>
  <section class="shell not-found"><span class="eyebrow">A LITTLE DETOUR</span><div class="error-number" aria-hidden="true">404<span>✳</span></div><h1>好像走进了一页空白。</h1><p>这个页面不存在，或已经换了一个位置。<br />不如回到首页，重新翻一翻。</p><a class="button button-primary" href={pathTo()}>回到首页 <Icon name="arrow" size={17} /></a></section>
</BaseLayout>
