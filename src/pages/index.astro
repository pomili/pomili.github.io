---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Icon from '../components/Icon.astro';
import { getPosts, pathTo } from '../lib/site';
const posts = (await getPosts()).slice(0, 3);
---
<BaseLayout>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="eyebrow"><span class="tiny-dot"></span> A LITTLE SPACE ON THE INTERNET</div>
      <h1 id="hero-title">你好，我是 <span class="name-highlight">pomili<svg viewBox="0 0 260 16" fill="none" aria-hidden="true"><path d="M3 11C66 1 173 0 256 8M25 15c82-7 154-6 201-3" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg></span><span class="hero-period">.</span><br />写一点，<span class="serif-text">想一点。</span></h1>
      <p class="hero-description">给想法一个落脚的地方。<br />在这里，记录细小的发现，也留一点空白给生活。</p>
      <div class="hero-actions"><a class="button button-primary" href={pathTo('blog/')}>读读我的文章 <Icon name="arrow" size={17} /></a><a class="text-link" href={pathTo('about/')}>关于这个小站 <span aria-hidden="true">↗</span></a></div>
      <div class="hero-footnote"><span class="small-line"></span> 不必匆忙，慢慢来就好。</div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="art-dots"></div><div class="art-orbit"></div>
      <span class="art-coordinate">FIELD NOTES / 001</span>
      <div class="paper paper-back"></div>
      <div class="paper paper-front">
        <div class="paper-heading"><span>A MOMENT OF QUIET</span><span>↗</span></div>
        <svg class="plant-art" viewBox="0 0 260 260" fill="none">
          <ellipse cx="128" cy="225" rx="72" ry="9" fill="currentColor" opacity=".06" />
          <circle cx="168" cy="85" r="64" fill="var(--art-circle)" />
          <path d="M122 211c0-49 2-99 30-151M127 157c-17-29-29-50-49-63M133 130c22-16 38-24 64-30" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path d="M142 85c-5-27 9-44 34-50-1 26-9 41-34 50Z" fill="var(--leaf-strong)" />
          <path d="M131 118c-27-1-44-16-43-43 24 4 39 18 43 43Z" fill="var(--leaf-soft)" />
          <path d="M135 135c8-27 28-40 57-32-11 23-30 35-57 32Z" fill="var(--leaf-strong)" />
          <path d="M125 163c-30-3-50-20-50-48 29 6 46 20 50 48Z" fill="var(--leaf-strong)" />
          <path d="M125 181c16-25 34-31 59-20-15 21-34 27-59 20Z" fill="var(--leaf-soft)" />
          <path d="m95 192 8 36h44l9-36Z" fill="var(--pot-color)" /><path d="M93 192h65" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path d="m147 73 17-24m-40 58-24-21m42 44 34-19m-57 45-31-27m42 48 38-12" stroke="var(--paper-color)" stroke-width="1" opacity=".6" />
        </svg>
        <div class="paper-caption"><span>让想法，自然生长。</span><span class="caption-rule"></span><span class="caption-small">GROW AT YOUR OWN PACE</span></div>
      </div>
      <div class="art-stamp"><Icon name="leaf" size={20} /><span>STAY<br />CURIOUS</span></div>
      <span class="art-bottom-note">a small corner, a world of thoughts.</span>
    </div>
  </section>
  <section class="latest-section shell" aria-labelledby="latest-heading">
    <div class="section-heading"><div><span class="eyebrow">THE NOTEBOOK</span><h2 id="latest-heading">最近写下的<span class="heading-dot"> /</span></h2></div><a class="text-link" href={pathTo('blog/')}>全部文章 <Icon name="arrow" size={16} /></a></div>
    <PostList posts={posts} />
  </section>
  <aside class="home-note shell"><span class="note-asterisk" aria-hidden="true">✳</span><div><span class="eyebrow">A SMALL REMINDER</span><p>值得记录的，不一定是大事。</p></div><span class="note-scribble" aria-hidden="true">keep a little wonder.</span></aside>
</BaseLayout>
