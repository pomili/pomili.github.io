---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pathTo, site } from '../lib/site';
---
<BaseLayout home>
  <div class="hero-background" aria-hidden="true"><picture><source media="(max-width: 767px)" srcset={pathTo(site.banners.mobile)} /><source media="(max-width: 1023px)" srcset={pathTo(site.banners.tablet)} /><img src={pathTo(site.banners.desktop)} alt="" width="1920" height="1080" fetchpriority="high" /></picture><div class="hero-veil"></div><div class="hero-grid"></div></div>
  <section class="hero-content" aria-labelledby="hero-title"><h1 id="hero-title">pomili 的空间</h1><p>{site.subtitle}</p></section>
</BaseLayout>
