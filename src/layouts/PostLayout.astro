---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { formatDate, pathTo, readingTime } from '../lib/site';
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
---
<BaseLayout title={post.data.title} description={post.data.description} article>
  <article class="article-content">
    <a class="back-link" href={pathTo('blog/')}>← 返回所有文章</a>
    <header class="article-header"><div class="post-meta"><span class="post-tag">{post.data.tags[0] || '随笔'}</span><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>约 {readingTime(post.body)} 分钟阅读</span></div><h1>{post.data.title}</h1><p>{post.data.description}</p></header>
    <div class="prose"><slot /></div>
    <footer class="article-footer"><span class="end-mark" aria-hidden="true">✳</span><p>谢谢你读到这里。</p><a class="text-link" href={pathTo('blog/')}>再读一篇 <span aria-hidden="true">↗</span></a></footer>
  </article>
</BaseLayout>
