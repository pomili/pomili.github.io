---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { formatDate, pathTo, postPath, readingTime } from '../lib/site';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  previous?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
}
const { post, headings, previous, next } = Astro.props;
---
<BaseLayout title={post.data.title} description={post.data.description} article>
  <div class="interior-page article-page">
    <div class="page-width">
      <nav class="breadcrumbs sr-only" aria-label="面包屑导航">
        <ol>
          <li><a href={pathTo()}>首页</a></li>
          <li><a href={pathTo('posts/')}>文章</a></li>
          <li><span aria-current="page">{post.data.title}</span></li>
        </ol>
      </nav>
      <article class="article-content">
        <header class="article-header">
          <div class="article-status-row">
            <span class="doc-id">DOC_ID: <code>{post.id}</code></span>
            <span class="online-status"><span class="status-dot" aria-hidden="true"></span> ONLINE</span>
          </div>
          <h1 class="article-title">{post.data.title}</h1>
          <div class="article-metadata-row">
            <div class="article-meta">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate).replaceAll('.', '-')}</time>
              <span aria-hidden="true">/</span>
              <span>约 {readingTime(post.body)} 分钟阅读</span>
            </div>
            {post.data.tags.length > 0 && <div class="article-tags">
              {post.data.tags.map((tag) => <a class="post-tag" href={pathTo(`tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>)}
            </div>}
          </div>
        </header>
        <div class="prose"><slot /></div>
        <footer class="article-footer">
          <span class="article-end">END OF DOCUMENT</span>
          <a class="back-link" href={pathTo('posts/')}><span aria-hidden="true">←</span> 返回文章列表</a>
        </footer>
        {(previous || next) && <nav class="post-navigation" aria-label="相邻文章">
          {previous && <a class="post-navigation-link" rel="prev" href={postPath(previous)}>
            <span class="post-navigation-label">← 上一篇</span>
            <span class="post-navigation-title">{previous.data.title}</span>
          </a>}
          {next && <a class="post-navigation-link post-navigation-next" rel="next" href={postPath(next)}>
            <span class="post-navigation-label">下一篇 <Icon name="arrow" size={16} /></span>
            <span class="post-navigation-title">{next.data.title}</span>
          </a>}
        </nav>}
      </article>
      <template id="page-toc">
        {headings.map((heading) => <a href={`#${heading.slug}`} data-depth={heading.depth}>{heading.text}</a>)}
      </template>
    </div>
  </div>
</BaseLayout>
