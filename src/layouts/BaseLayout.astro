---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, pathTo } from '../lib/site';
import '../styles/global.css';
interface Props { title?: string; description?: string; article?: boolean; noindex?: boolean; }
const { title, description = site.description, article = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — pomili` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('pomili-theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="pomili" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={pathTo('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="pomili 的文章" href={pathTo('rss.xml')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="pomili" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
