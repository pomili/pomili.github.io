  friends: 'M8 4h8l5 8-5 8H8l-5-8ZM12 8v8M8 12h8',
  star: 'm12 2 3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1Z',
  search: 'M16 16l5 5',
  arrow: 'M4 12h16M14 6l6 6-6 6',
  up: 'M12 21V3M5 10l7-7 7 7',
  menu: 'M3 6h18M3 12h18M3 18h18',
  close: 'm5 5 14 14M5 19 19 5',
  toc: 'M8 5h13M8 12h13M8 19h13M3 5h.01M3 12h.01M3 19h.01',
  github: 'M9 20c-5 1-5-3-7-3M15 22v-4c0-1 0-2-1-3 4 0 7-2 7-6 0-2-1-3-2-4 0-1 0-2-1-3-2 0-3 1-4 2a15 15 0 0 0-5 0C8 3 7 2 5 2c-1 1-1 2-1 3-1 1-2 2-2 4 0 4 3 6 7 6-1 1-1 2-1 3v4',
