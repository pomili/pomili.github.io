};
---
<svg width={size} height={size} viewBox="0 0 24 24" fill={name === 'home' || name === 'star' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {paths[name] && <path d={paths[name]} />}
  {name === 'info' && <circle cx="12" cy="12" r="9" />}
  {name === 'search' && <circle cx="10" cy="10" r="7" />}
  {name === 'sun' && <circle cx="12" cy="12" r="4" />}
  {name === 'rss' && <circle cx="5" cy="19" r="1" fill="currentColor" />}
</svg>
