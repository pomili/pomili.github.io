  posts: 'M4 5h16M4 9h16M4 13h11M4 17h8M4 21h5',
  tag: 'M3 3h8l10 10-8 8L3 11Z M7 7h.01',
  archive: 'M3 4h18v4H3ZM5 8v12h14V8M9 12h6',
