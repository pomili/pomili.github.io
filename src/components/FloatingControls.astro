---
import Icon from './Icon.astro';
---
<div class="floating-controls" aria-label="页面工具">
  <button class="control-button toc-toggle" type="button" aria-label="打开文章目录" aria-expanded="false" aria-controls="toc-drawer" hidden><span class="scroll-percent">0%</span><span class="toc-glyph"><Icon name="toc" /></span></button>
  <button class="control-button top-button" type="button" aria-label="返回顶部" title="返回顶部"><Icon name="up" size={18} /></button>
  <button class="control-button theme-toggle" type="button" aria-label="切换深浅色" title="切换深浅色" aria-pressed="false"><span class="theme-moon"><Icon name="moon" size={18} /></span><span class="theme-sun"><Icon name="sun" size={18} /></span></button>
</div>
<aside class="toc-drawer" id="toc-drawer" aria-label="文章目录" hidden><div class="toc-heading"><span>目录</span><button class="toc-close" type="button" aria-label="关闭目录"><Icon name="close" size={18} /></button></div><nav class="toc-links" aria-label="章节"></nav></aside>
<div class="page-spinner" hidden aria-hidden="true"><span></span></div>
