---
import type { CollectionEntry } from 'astro:content';
import { formatDate, postPath, readingTime } from '../lib/site';
import Icon from './Icon.astro';
interface Props { posts: CollectionEntry<'blog'>[]; }
const { posts } = Astro.props;
---
<ul class="post-list">
  {posts.map((post, index) => <li class="post-row">
    <span class="post-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <a class="post-link" href={postPath(post)}>
      <div class="post-meta"><span class="post-tag">{post.data.tags[0] || '随笔'}</span><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></div>
      <h3>{post.data.title}</h3>
      <p>{post.data.description}</p>
      <span class="read-time">约 {readingTime(post.body)} 分钟阅读</span>
      <span class="post-arrow"><Icon name="arrow" /></span>
    </a>
  </li>)}
</ul>
